@echo off
setlocal EnableExtensions DisableDelayedExpansion
rem Visual Encounters publisher.
rem The outer process always pauses, even if the inner script exits on a CMD syntax error.

if /I "%~1"=="--worker" goto :worker

title Visual Encounters - Publish Website
echo.
echo ==========================================
echo   VISUAL ENCOUNTERS - GIT PUBLISHER
echo ==========================================
echo.
echo Running in: %~dp0
echo.

rem A separate CMD process isolates fatal parsing errors in the worker.
"%ComSpec%" /D /C ""%~f0" --worker"
set "PUBLISH_EXIT=%ERRORLEVEL%"
echo.
if "%PUBLISH_EXIT%"=="0" (
    echo [FINISHED] See results above.
) else (
    echo [FAILED] Publishing stopped with exit code %PUBLISH_EXIT%.
    echo Review the error messages above. Nothing else will run automatically.
)
echo.
echo Press any key to close this window...
pause >nul
exit /b %PUBLISH_EXIT%

:worker
pushd "%~dp0"
if errorlevel 1 (
    echo [ERROR] Unable to enter the folder containing publish.bat.
    exit /b 1
)

where git >nul 2>nul
if errorlevel 1 (
    echo [ERROR] Git not found on PATH. Install Git for Windows.
    goto :failure
)
if not exist ".git" (
    echo [ERROR] This file must be in the Git repository root.
    echo [INFO]  Expected .git and index.html in: %CD%
    goto :failure
)
if not exist "tools\update_site_version.py" (
    echo [ERROR] Missing tools\update_site_version.py.
    echo [INFO]  Install the Visual Encounters cache-update patch first.
    goto :failure
)

set "BRANCH="
for /f "delims=" %%B in ('git branch --show-current 2^>nul') do set "BRANCH=%%B"
if not defined BRANCH (
    echo [ERROR] Cannot determine current Git branch.
    echo [INFO]  Check for a detached HEAD or a Git error.
    goto :failure
)

echo [INFO] Branch: %BRANCH%
echo.
echo [1/5] Staging all local changes...
git add -A
if errorlevel 1 goto :failure

echo.
echo [2/5] Updating release version and cache-busting references...
call :run_updater
if errorlevel 1 (
    echo [ERROR] Version tool failed. No commit or push has been attempted.
    goto :failure
)

echo.
echo [3/5] Staging files generated by the version tool...
git add -A
if errorlevel 1 goto :failure

git diff --cached --quiet
set "DIFF_EXIT=%ERRORLEVEL%"
if "%DIFF_EXIT%"=="0" goto :no_changes
if not "%DIFF_EXIT%"=="1" (
    echo [ERROR] Unable to read staged changes.
    goto :failure
)

echo.
echo Changes staged for the next commit:
git diff --cached --stat
echo.
echo Files staged [A = added, M = modified, D = deleted]:
git diff --cached --name-status

echo.
echo [4/5] Commit message
set "COMMIT_MSG="
set /p "COMMIT_MSG=Enter commit message: "
if not defined COMMIT_MSG goto :cancel

echo.
set "CONFIRM="
set /p "CONFIRM=Commit and push ALL staged changes? [y/N]: "
if /I "%CONFIRM%"=="y" goto :do_commit
if /I "%CONFIRM%"=="yes" goto :do_commit
goto :cancel

:do_commit
git commit -m "%COMMIT_MSG%"
if errorlevel 1 (
    echo [ERROR] Commit failed. Check Git user.name and user.email settings.
    goto :failure
)

echo.
echo [5/5] Pushing branch %BRANCH%...
git rev-parse --abbrev-ref --symbolic-full-name "@{upstream}" >nul 2>nul
if errorlevel 1 goto :first_push
git push
if errorlevel 1 goto :push_failed
goto :success

:first_push
git remote get-url origin >nul 2>nul
if errorlevel 1 (
    echo [ERROR] No upstream branch or origin remote. Commit saved locally.
    goto :failure
)
git push -u origin "%BRANCH%"
if errorlevel 1 goto :push_failed
goto :success

:run_updater
where py >nul 2>nul
if not errorlevel 1 (
    py -3 -c "import sys" >nul 2>nul
    if not errorlevel 1 (
        py -3 "tools\update_site_version.py"
        if errorlevel 1 exit /b 1
        exit /b 0
    )
)
where python >nul 2>nul
if not errorlevel 1 (
    python -c "import sys; assert sys.version_info.major == 3" >nul 2>nul
    if not errorlevel 1 (
        python "tools\update_site_version.py"
        if errorlevel 1 exit /b 1
        exit /b 0
    )
)
where python3 >nul 2>nul
if not errorlevel 1 (
    python3 -c "import sys; assert sys.version_info.major == 3" >nul 2>nul
    if not errorlevel 1 (
        python3 "tools\update_site_version.py"
        if errorlevel 1 exit /b 1
        exit /b 0
    )
)
echo [ERROR] Python 3 not found. Install Python 3 or enable the py launcher.
exit /b 1

:no_changes
echo.
echo [INFO] No staged changes. No commit or push needed.
goto :success

:cancel
echo.
echo [CANCELLED] No commit or push. Changes remain staged.
goto :success

:push_failed
echo.
echo [ERROR] Git push failed. Your commit is preserved locally.
echo [INFO]  Check remote URL, authentication, or branch protection.
goto :failure

:success
popd
exit /b 0

:failure
echo.
echo [FAILED] See error messages above.
popd
exit /b 1
